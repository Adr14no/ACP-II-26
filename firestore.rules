rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/libraryData/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /normas/{normaId} {
      allow read: if request.auth != null
        && (isAdmin() || resource.data.status == 'published');
      allow create: if isAdmin() && request.resource.data.status == 'draft';
      allow update: if isAdmin()
        && resource.data.status == 'draft'
        && request.resource.data.status == 'draft';
      allow delete: if isAdmin() && resource.data.status == 'draft';
    }

    match /videos/{videoId} {
      allow read: if request.auth != null
        && (isAdmin() || resource.data.status == 'published');
      allow create, update, delete: if isAdmin();
    }

    // Auditoria: usuários só podem criar eventos vinculados à própria conta.
    // A consulta global é exclusiva de administradores ativos.
    match /systemLogs/{logId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.type in ['login', 'logout', 'heartbeat']
        && request.resource.data.createdAt == request.time
        && request.resource.data.clientTime is timestamp;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}

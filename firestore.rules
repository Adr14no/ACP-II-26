rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Estatísticas coletivas: leitura para usuários autenticados; escrita exclusiva pela Cloud Function.
    match /questionStats/{questionId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
      match /responses/{userId} {
        allow read, write: if false;
      }
    }

    match /users/{userId}/libraryData/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /normas/{normaId} {
      allow read: if request.auth != null
        && (isAdmin() || resource.data.status == 'published');
      allow create: if isAdmin() && request.resource.data.status == 'draft';
      allow update: if isAdmin()
        && resource.data.status == 'draft'
        && request.resource.data.status == 'draft';
      allow delete: if isAdmin() && resource.data.status == 'draft';
    }

    match /videos/{videoId} {
      allow read: if request.auth != null
        && (isAdmin() || resource.data.status == 'published');
      allow create, update, delete: if isAdmin();
    }

    // Notificações: administradores ativos gerenciam os avisos; alunos leem apenas os publicados.
    match /notifications/{notificationId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.active == true);
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.active is bool;
      allow update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    // Estado de leitura/exclusão é individual. Apagar para mim não remove o aviso global.
    match /userNotificationState/{stateId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.noticeId is string
        && request.resource.data.read is bool
        && request.resource.data.deleted is bool;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.noticeId == resource.data.noticeId
        && request.resource.data.read is bool
        && request.resource.data.deleted is bool;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Auditoria: usuários só podem criar eventos vinculados à própria conta.
    // A consulta global é exclusiva de administradores ativos.

    // Central de Atendimento: cada aluno acessa somente os próprios protocolos.
    // Administradores ativos podem consultar, responder e alterar o status.
    function ticketOwner(ticketId) {
      return request.auth != null
        && get(/databases/$(database)/documents/atendimentos/$(ticketId)).data.uid == request.auth.uid;
    }
    function ticketOwnerAfter(ticketId) {
      return request.auth != null
        && getAfter(/databases/$(database)/documents/atendimentos/$(ticketId)).data.uid == request.auth.uid;
    }

    match /atendimentos/{ticketId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'studentName', 'studentEmail', 'course', 'category', 'subject', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.course in ['ACP', 'CAO']
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.category is string
        && request.resource.data.status == 'new'
        && request.resource.data.studentName is string
        && request.resource.data.studentEmail is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'progress', 'replied', 'closed']
        && request.resource.data.updatedAt == request.time
        || (request.auth != null
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'hiddenForStudent'])
          && request.resource.data.updatedAt == request.time
          && (!('hiddenForStudent' in request.resource.data) || request.resource.data.hiddenForStudent == true));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAdmin() || ticketOwner(ticketId);
        allow create: if request.resource.data.keys().hasOnly(['text', 'senderUid', 'senderName', 'senderRole', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.createdAt == request.time
          && ((isAdmin() && request.resource.data.senderRole == 'admin')
            || (ticketOwnerAfter(ticketId)
              && getAfter(/databases/$(database)/documents/atendimentos/$(ticketId)).data.status != 'closed'
              && request.resource.data.senderRole == 'student'));
        allow update, delete: if false;
      }
    }

    match /systemLogs/{logId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.type in ['login', 'logout', 'heartbeat']
        && request.resource.data.createdAt == request.time
        && request.resource.data.clientTime is timestamp;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
